{
  "name": "mov-reservations",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "dev:web": "pnpm --filter @mov-reservations/web dev",
    "build:web": "pnpm --filter @mov-reservations/web build",
    "dev:api": "pnpm --filter @mov-reservations/api dev",
    "start:api": "pnpm --filter @mov-reservations/api start",
    "build:api": "pnpm --filter @mov-reservations/api build",
    "db:push": "pnpm --filter @mov-reservations/api db:push",
    "db:seed": "pnpm --filter @mov-reservations/api db:seed",
    "db:reset": "pnpm --filter @mov-reservations/api db:reset",
    "db:generate": "pnpm --filter @mov-reservations/api db:generate",
    "db:migrate": "pnpm --filter @mov-reservations/api db:migrate"
  },
  "devDependencies": {
    "turbo": "^2.5.8"
  }
}
